# Copy this file to .env and fill in local values.
# Add one AI provider before job evaluation/scoring.
# The three model names must belong to this same provider/API key.
#
# Supported AI_PROVIDER_NAME values:
# openai, anthropic, claude, gemini, openrouter, deepseek, kimi, moonshot,
# glm, zhipu, custom
#
# AI_BASE_URL is optional for built-in providers. Use it only for custom
# OpenAI-compatible endpoints or an endpoint override.
#
# Model examples:
# OpenAI: gpt-5, gpt-4.1-mini
# Anthropic/Claude: claude-sonnet-4-5, claude-3-5-haiku-latest
# DeepSeek: deepseek-chat, deepseek-reasoner
# Kimi/Moonshot: moonshot-v1-32k
# GLM/Zhipu: glm-4-flash

AI_PROVIDER_NAME=
AI_API_KEY=
AI_BASE_URL=

PRIMARY_MODEL=
FALLBACK_MODEL=
SECOND_FALLBACK_MODEL=
