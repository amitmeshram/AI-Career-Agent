# Sample AI model settings for .env
# Copy one block into .env, then replace the API key with your real key.
# Use three model names from the same provider/API key.

# OpenAI
AI_PROVIDER_NAME=openai
AI_API_KEY=sk-your-openai-key

PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=gpt-4.1-mini
SECOND_FALLBACK_MODEL=gpt-4o


# Anthropic / Claude
AI_PROVIDER_NAME=anthropic
AI_API_KEY=sk-ant-your-anthropic-key

PRIMARY_MODEL=claude-3-5-sonnet-latest
FALLBACK_MODEL=claude-3-5-haiku-latest
SECOND_FALLBACK_MODEL=claude-3-opus-latest


# Gemini
AI_PROVIDER_NAME=gemini
AI_API_KEY=your-gemini-key

PRIMARY_MODEL=gemini-1.5-pro
FALLBACK_MODEL=gemini-1.5-flash
SECOND_FALLBACK_MODEL=gemini-1.0-pro


# DeepSeek
AI_PROVIDER_NAME=deepseek
AI_API_KEY=sk-your-deepseek-key

PRIMARY_MODEL=deepseek-chat
FALLBACK_MODEL=deepseek-reasoner
SECOND_FALLBACK_MODEL=deepseek-chat


# Kimi / Moonshot
AI_PROVIDER_NAME=kimi
AI_API_KEY=sk-your-kimi-key

PRIMARY_MODEL=kimi-k2-0711-preview
FALLBACK_MODEL=moonshot-v1-32k
SECOND_FALLBACK_MODEL=moonshot-v1-8k


# GLM
AI_PROVIDER_NAME=glm
AI_API_KEY=your-glm-key

PRIMARY_MODEL=glm-5.2
FALLBACK_MODEL=glm-4.5
SECOND_FALLBACK_MODEL=glm-4-flash


# OpenRouter
AI_PROVIDER_NAME=openrouter
AI_API_KEY=sk-or-your-openrouter-key

PRIMARY_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=anthropic/claude-3.5-sonnet
SECOND_FALLBACK_MODEL=google/gemini-flash-1.5
